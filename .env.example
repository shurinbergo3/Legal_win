# Telegram bot — see TELEGRAM.md for full setup
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# Comma-separated chat IDs that receive form requests and have admin rights
TELEGRAM_OPERATOR_CHAT_IDS=
# Optional shared secret to verify incoming webhook calls
TELEGRAM_WEBHOOK_SECRET=

# AI chatbot provider — Groq (llama-3.3-70b-versatile via OpenAI-compatible API)
# Get one at https://console.groq.com
GROQ_API_KEY=gsk_...

# Site metadata
NEXT_PUBLIC_SITE_URL=https://legalwin.pl

# --- Чат-бот ---
# OpenAI - основной провайдер. Groq выше остаётся резервом: если OpenAI
# отвечает ошибкой, следующие 3 минуты запросы идут в Groq.
OPENAI_API_KEY=sk-proj-...
# Необязательно - переопределить модели без релиза
OPENAI_CHAT_MODEL=gpt-5.4
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
